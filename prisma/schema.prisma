// 시가총액 상위 종목 유니버스 + 배치로 계산한 스크리너 지표를 저장하는 스키마.
// 로컬 MySQL로 연결합니다 (SQLite로 되돌리려면 provider를 "sqlite"로,
// DATABASE_URL을 "file:./dev.db"로 바꾸면 됩니다).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Stock {
  ticker     String   @id
  name       String
  sector     String
  market     String // KOSPI | KOSDAQ
  price      Int
  chg        Float
  cap        String // "2,069조원" 같은 표시용 문자열
  capEok     Float // 정렬/필터용 원본 숫자 (억원 단위)
  per        Float?
  pbr        Float? // PBR(주가순자산비율). 기존 per 컬럼과 같은 방식(nullable + 기본값 없음)으로
                     // 추가 — 이미 있는 row는 다음 배치("새로고침" 버튼)가 돌 때 채워집니다.
  hi         Int
  lo         Int
  ma5over20  Boolean
  volRatio   Float
  rsi        Float
  screenerOk    Boolean // score >= 3 캐시 (조회 편의용)
  // MACD 히스토그램이 음수(하락 모멘텀)지만 최근 3거래일 연속 0에
  // 가까워지는 중인지(indicators.ts isMacdReboundSignal). 4개 스크리너
  // 규칙과 별개의 독립 신호라 screenerScore에는 안 들어가고 필터 전용.
  macdRebound   Boolean  @default(false)
  screenerScore Int      @default(0) // 4개 규칙 중 몇 개 통과했는지(0~4). "스크리너 많이 통과한 순" 정렬용.
  // 등급(screener.ts getRecommendation)을 숫자로 캐시한 값. 3=완전충족, 2=조건충족,
  // 1=보류, 0=주의(desc 정렬 시 완전충족이 먼저). 업종 평균 PER/PBR이 필요해
  // refreshUniverse()가 전 종목 저장 후 2차 패스에서 채운다. 화면 배지는 실시간 데이터로
  // 클라이언트가 계산하고, 이 컬럼은 서버 페이지네이션의 등급순 정렬에만 쓴다
  // (마지막 새로고침 시점 기준 스냅샷).
  recommendationRank Int @default(0)
  updatedAt     DateTime @updatedAt

  @@index([sector])
  @@index([screenerOk])
  @@index([screenerScore])
  @@index([recommendationRank])
  @@index([macdRebound])
}

// 유니버스 새로고침 동시 실행을 막는 락. 서버리스 인스턴스는 메모리를 공유하지 않아
// 메모리 변수로는 막을 수 없으므로(동시 upsert 시 MySQL Lock wait timeout 발생),
// 싱글턴 row(id=1)를 조건부 UPDATE로 원자적으로 획득한다
// (refresh-universe.ts acquireRefreshLock 참고).
model RefreshLock {
  id        Int      @id @default(1)
  isRunning Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// KIS 접근토큰(OAuth) 캐시. 서버리스 인스턴스마다 메모리 캐시가 비어 토큰을 새로
// 발급받게 되는데, KIS는 발급을 분당 1회로 제한한다(EGW00133). 토큰 유효기간이
// 약 24시간이라 DB에 캐싱해 인스턴스 수와 관계없이 하루 한 번 정도만 발급받는다.
model KisToken {
  id        Int      @id @default(1)
  token     String   @db.Text
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// User/Session/Account/Verification은 better-auth Prisma 어댑터의 표준 스키마를
// 그대로 따른다(필드명·타입을 바꾸면 어댑터가 인식하지 못한다).
// 비밀번호 해시는 Account.password에 저장된다.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // 관리자 전용 기능(유니버스 새로고침, AI 추천 등) 접근 여부. 역할이 여러 개
  // 필요해지면 role 필드로 바꾼다.
  isAdmin       Boolean   @default(false)
  // 공시 푸시 알림 수신 여부("알림" 탭). 꺼두면 dart-poll.ts가 발송 대상에서 제외한다
  // (토큰은 유지하므로 다시 켜면 바로 재개된다).
  notificationsEnabled Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions   Session[]
  accounts   Account[]
  watchlist  Watchlist[]
  pushTokens PushToken[]
}

// 공시 알림용 FCM 디바이스 토큰. 유저 1:N(여러 기기), token이 기기를 식별하므로
// @unique로 두어 재등록 시 upsert한다.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  disclosureDeliveries DisclosureDelivery[]

  @@index([userId])
}

// DART 공시 폴링(크론)이 동시에 두 번 안 돌게 막는 락. RefreshLock과 똑같은
// CAS 패턴 — 이유도 동일(Vercel 서버리스 인스턴스가 여러 개라 인메모리
// 변수로는 못 막음, refresh-universe.ts 주석 참고).
model DartPollLock {
  id        Int      @id @default(1)
  isRunning Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// AI 추천 탭(관리자 전용)의 마지막 생성 결과. 비용과 속도 때문에 "다시 생성하기"를
// 누를 때만 Claude를 호출하고, 결과를 싱글턴 row(id=1)에 덮어쓴다.
model AiPickBatch {
  id          Int      @id @default(1)
  generatedAt DateTime @default(now())
  model       String
  payload     Json // AiPick[] — src/lib/ai-picks.ts 참고
}

// 이미 알림을 보낸 공시(rcept_no, DART 접수번호 — 공시 하나당 고유)를
// 기록해서 같은 공시로 두 번 알림 안 가게 막음.
model NotifiedDisclosure {
  rcept_no String   @id
  sentAt   DateTime @default(now())
}

// 공시 수집과 기기별 FCM 접수 결과를 분리해 실패한 대상만 재시도합니다.
model DisclosureNotification {
  rceptNo     String   @id
  ticker      String
  corpName    String
  reportName  String
  createdAt   DateTime @default(now())
  completedAt DateTime?
  lastAttemptAt DateTime?
  deliveries  DisclosureDelivery[]

  @@index([completedAt, lastAttemptAt])
}

model DisclosureDelivery {
  rceptNo     String
  pushTokenId String
  userId      String
  status      String   @default("pending") // pending | sent | skipped
  updatedAt   DateTime @updatedAt
  notification DisclosureNotification @relation(fields: [rceptNo], references: [rceptNo], onDelete: Cascade)
  pushToken    PushToken @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)

  @@id([rceptNo, pushTokenId])
  @@index([pushTokenId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  // better-auth 1.7에서 추가된 필드. 계정의 인증 방식 식별자로, 이메일+비밀번호
  // 로그인은 "local:credential"이 자동으로 들어간다.
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// 사용자가 화면에서 추가/삭제하는 관심종목. 이제 유저별로 분리되어 있어서
// (userId, ticker) 조합이 유니크 — 같은 종목이라도 유저마다 별도 row예요.
// stock-advisor-server(Spring)가 시작할 때 이 테이블을 distinct ticker로
// 읽어서 KIS 웹소켓 실시간 구독 목록을 만듭니다(유저별이 아니라 전체 공유 —
// 여러 유저가 같은 종목을 담아도 구독은 하나로 합쳐짐). Spring은 이 테이블에
// 더 이상 쓰지 않고 읽기만 합니다(ddl-auto: none) — userId를 모르는
// Spring이 직접 INSERT하면 어느 유저 것인지 알 수 없어서, DB 쓰기는
// Next.js/Prisma 쪽에서만 함.
model Watchlist {
  id      String   @id @default(cuid())
  userId  String
  ticker  String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([ticker])
}
